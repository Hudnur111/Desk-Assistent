ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-sonnet-5
JARVIS_LOG_LEVEL=INFO

# Sprach-I/O (Phase 2) - optional
JARVIS_VOICE_ENABLED=false
JARVIS_WHISPER_MODEL=tiny
JARVIS_WAKEWORD_MODELS=hey_jarvis
JARVIS_PIPER_MODEL_PATH=
JARVIS_PIPER_CONFIG_PATH=

# Buero-Automatisierung (Phase 3) - optional, aktiviert das E-Mail-Entwurf-Tool
# Fuer Gmail: IMAP aktivieren + App-Passwort erstellen (myaccount.google.com/apppasswords)
JARVIS_IMAP_HOST=imap.gmail.com
JARVIS_EMAIL_ADDRESS=
JARVIS_EMAIL_PASSWORD=
JARVIS_EMAIL_DRAFTS_FOLDER=[Gmail]/Drafts

# Display-UI (Phase 4) - optional
JARVIS_UI_ENABLED=false
JARVIS_UI_HOST=127.0.0.1
JARVIS_UI_PORT=8000
